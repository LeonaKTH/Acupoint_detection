<view class="container"><view>穴位定位实验室</view><view class="hint">算法研究与教学演示。耳部请上传裁剪后的耳朵图片。</view><input password placeholder="演示密码" value="{{password}}" bindinput="onPassword"/><button bindtap="login">登录</button><picker range="{{regions}}" value="{{index}}" bindchange="onRegion">部位：{{regions[index]}}</picker><button bindtap="choose">拍照或选择图片</button><image wx:if="{{image}}" src="{{image}}" mode="widthFix"/><button bindtap="detect">开始定位</button><view>{{status}}</view><view wx:for="{{points}}" wx:key="id">{{item.name}}：{{item.x}}，{{item.y}}</view><button bindtap="history">查看历史记录数量</button></view>
